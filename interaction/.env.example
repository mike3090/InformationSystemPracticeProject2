OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
VRCHAT_AI_HOST=127.0.0.1
VRCHAT_AI_PORT=8765
VRCHAT_AI_SERVER_URL=http://127.0.0.1:8765

# Audio capture mode:
# - speaker: capture a Windows playback device through loopback, useful for hearing VRChat/other players.
# - microphone: capture a physical microphone directly, useful for one-person local testing.
VRCHAT_AI_CAPTURE_MODE=speaker

# Leave empty to capture the default Windows playback device in speaker mode.
VRCHAT_AI_CAPTURE_SPEAKER=

# Leave empty to capture the default Windows microphone in microphone mode.
VRCHAT_AI_CAPTURE_MICROPHONE=

# Text output targets: console, osc, or console,osc.
# Use osc only after enabling OSC in VRChat.
VRCHAT_AI_TEXT_OUTPUT=console,file
VRCHAT_AI_TRANSCRIPT_PATH=.tmp/transcript.log
VRCHAT_AI_OSC_HOST=127.0.0.1
VRCHAT_AI_OSC_PORT=9000
VRCHAT_AI_OSC_SEND_IMMEDIATELY=true

# Optional TTS output. When enabled, LLM replies are spoken to the selected playback device.
VRCHAT_AI_TTS_ENABLED=false
VRCHAT_AI_TTS_MODEL=tts-1
VRCHAT_AI_TTS_VOICE=alloy
VRCHAT_AI_TTS_OUTPUT_SPEAKER=MIXLINE
VRCHAT_AI_TTS_RESPONSE_FORMAT=pcm
VRCHAT_AI_TTS_STREAMING=true
VRCHAT_AI_TTS_VRCHAT_MIC_CONTROL=off
VRCHAT_AI_TTS_MIC_PRE_DELAY_SECONDS=0.15
VRCHAT_AI_TTS_MIC_POST_DELAY_SECONDS=0.25
VRCHAT_AI_POST_TTS_COOLDOWN_SECONDS=0.4
VRCHAT_AI_TTS_ECHO_SIMILARITY=0.82

# faster-whisper model name or local model path.
VRCHAT_AI_TRANSCRIBE_MODEL=base
VRCHAT_AI_TRANSCRIBE_DEVICE=cpu
VRCHAT_AI_TRANSCRIBE_COMPUTE_TYPE=int8
VRCHAT_AI_TRANSCRIBE_LANGUAGE=
VRCHAT_AI_TRANSCRIBE_ALLOWED_LANGUAGES=ja,zh,en

VRCHAT_AI_SAMPLE_RATE=16000
VRCHAT_AI_CHUNK_SECONDS=0.25
VRCHAT_AI_RMS_THRESHOLD=0.012
VRCHAT_AI_MIN_SEGMENT_SECONDS=0.8
VRCHAT_AI_SILENCE_SECONDS=0.9
VRCHAT_AI_MAX_SEGMENT_SECONDS=12.0

# Use a Markdown prompt file for multiline prompts.
VRCHAT_AI_SYSTEM_PROMPT_FILE=prompts/system.md

# Fallback single-line prompt if VRCHAT_AI_SYSTEM_PROMPT_FILE is empty.
VRCHAT_AI_SYSTEM_PROMPT=You are a friendly AI companion in VRChat. Reply briefly and naturally for an in-world chatbox.
